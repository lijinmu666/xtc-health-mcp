{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xtc-health-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DEFAULT_DEVICE_ID": "xtc-z8a"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xtc-health",
      "database_id": "7d38c7ef7e684fde958587e135630dba"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "xtc-health-oauth"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_HUB",
        "class_name": "DeviceHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceHub"]
    }
  ]
}
